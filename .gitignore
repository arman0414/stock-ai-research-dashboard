# ML artifacts: keep small metadata JSON (reproducibility), ignore large trained binaries
artifacts/models/**/*.joblib
artifacts/champions/
artifacts/benchmarks/

# Frontend
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/coverage/
frontend/*.tsbuildinfo
frontend/npm-debug.log*

# OS / editor
.DS_Store
*.log
